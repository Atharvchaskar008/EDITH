root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# the story page and the teammates' packs keep their own formatting
[{landing,addons/a_history,addons/c_ops}/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
